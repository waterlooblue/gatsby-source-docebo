{
  "name": "gatsby-source-docebo",
  "version": "1.0.7",
  "description": "Gatsby source plugin for building websites using Docebo as a data source",
  "main": "gatsby-node.js",
  "types": "dist/gatsby-node.d.ts",
  "files": [
    "gatsby-node.js",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "author": "Christopher Norkett <christopher.norkett@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "gatsby": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "gatsby": "^5.16.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "gatsby",
    "gatsby-plugin",
    "gatsby-source-plugin"
  ]
}
